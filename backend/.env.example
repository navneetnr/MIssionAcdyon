# Path to the SQLite database file. Relative paths are resolved from the
# directory uvicorn is started in. On most PaaS free tiers (Render, Railway)
# the filesystem is ephemeral, so treat this as a cache, not durable storage -
# see "Limitations" in README.md.
DATABASE_PATH=jobs.db

# Comma-separated list of origins allowed to call this API from a browser.
# Add your deployed frontend's URL here in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
